# ---- Large data / generated content ----
# NotoSansJP-Regular SDF.asset が 131MB あり GitHub の 100MB 制限を超えるため除外。
# ただし TMP のグローバルフォールバック（TMP Settings.asset）が参照している
# Dynamic 版と、その実行時ラスタライズ元の TTF だけは追跡する（計 5.6MB）。
# これが無いと clone 先で日本語が豆腐になる。Noto Sans JP は SIL OFL。
# ディレクトリ自体ではなく中身を除外する（git は除外したディレクトリを
# 走査しないため、"/Assets/Fonts/" と書くと下の ! が効かない）。
/Assets/Fonts/*
!/Assets/Fonts/NotoSansJP-Regular.ttf
!/Assets/Fonts/NotoSansJP-Regular.ttf.meta
!/Assets/Fonts/NotoSansJP-Regular SDF Dynamic.asset
!/Assets/Fonts/NotoSansJP-Regular SDF Dynamic.asset.meta
/StreamingData/
/demo/
/.utmp/

# XREAL XR Plugin (248MB)。ライセンス上も再配布せず、各自 XREAL 公式から入手する
/Packages/com.xreal.xr.tar.gz

# ---- Local tooling ----
/.claude/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
